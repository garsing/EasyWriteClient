{
  "manifest_version": 3,
  "name": "易写浏览器助手",
  "version": "0.1.3",
  "description": "将当前 Chrome/Edge 标签页附着到易写，供读页与操作。仅经本机 Native Messaging 与易写通信。",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "易写浏览器助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
