<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>EasyWriteClient.Desktop</RootNamespace>
    <AssemblyName>EasyWriteClient.Desktop</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\yi-write.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>EasyWriteClient.Desktop.Program</StartupObject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\EasyWriteClient.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <OfficePiaDir>C:\Program Files (x86)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15</OfficePiaDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>$(OfficePiaDir)\Microsoft.Office.Interop.Word.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 运行时配置与前端产物 -->
  <ItemGroup>
    <Content Include="..\Plugin\config.json" Link="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Assets\yi-write_logo1.png" />
    <Content Include="Assets\yi-write.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWwwrootFromPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_PluginWwwroot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Plugin\wwwroot'))</_PluginWwwroot>
      <_DesktopWwwroot>$(OutputPath)wwwroot</_DesktopWwwroot>
    </PropertyGroup>
    <Message Importance="high" Text="Copy wwwroot: $(_PluginWwwroot) → $(_DesktopWwwroot)" Condition="Exists('$(_PluginWwwroot)\index.html')" />
    <ItemGroup Condition="Exists('$(_PluginWwwroot)\index.html')">
      <_WwwFiles Include="$(_PluginWwwroot)\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WwwFiles)"
      DestinationFiles="@(_WwwFiles->'$(_DesktopWwwroot)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_PluginWwwroot)\index.html')" />
    <Warning Text="Plugin/wwwroot 不存在或缺少 index.html。请先在 Plugin/frontend 执行 npm run build。" Condition="!Exists('$(_PluginWwwroot)\index.html')" />
  </Target>
</Project>
