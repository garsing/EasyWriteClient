<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>EasyWriteClient.Desktop</RootNamespace>
    <AssemblyName>EasyWriteClient.Desktop</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\yi-write.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>EasyWriteClient.Desktop.Program</StartupObject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\EasyWriteClient.Shared.csproj" />
    <ProjectReference Include="..\BrowserBridge\YiWriteBrowserBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" />
  </ItemGroup>

  <PropertyGroup>
    <OfficePiaDir>C:\Program Files (x86)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15</OfficePiaDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>$(OfficePiaDir)\Microsoft.Office.Interop.Word.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 运行时配置与前端产物 -->
  <ItemGroup>
    <Content Include="..\Plugin\config.json" Link="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Assets\yi-write_logo1.png" />
    <Content Include="Assets\yi-write.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWwwrootFromSharedFrontend" AfterTargets="Build">
    <PropertyGroup>
      <_SharedWwwroot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Shared\Frontend\wwwroot'))</_SharedWwwroot>
      <_DesktopWwwroot>$(OutputPath)wwwroot</_DesktopWwwroot>
    </PropertyGroup>
    <Message Importance="high" Text="Copy wwwroot: $(_SharedWwwroot) → $(_DesktopWwwroot)" Condition="Exists('$(_SharedWwwroot)\index.html')" />
    <ItemGroup Condition="Exists('$(_SharedWwwroot)\index.html')">
      <_WwwFiles Include="$(_SharedWwwroot)\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WwwFiles)"
      DestinationFiles="@(_WwwFiles->'$(_DesktopWwwroot)\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_SharedWwwroot)\index.html')" />
    <Warning Text="Shared/Frontend/wwwroot 不存在或缺少 index.html。请先在 Shared/Frontend 执行 npm run build。" Condition="!Exists('$(_SharedWwwroot)\index.html')" />
  </Target>

  <!-- PdfiumViewer 只带托管程序集；原生 pdfium.dll 须落到输出目录的 x64/x86 -->
  <Target Name="CopyPdfiumNative" AfterTargets="Build">
    <PropertyGroup>
      <_PdfiumX64>$(MSBuildThisFileDirectory)..\Plugin\packages\PdfiumViewer.Native.x86_64.v8-xfa.2018.4.8.256\Build\x64\pdfium.dll</_PdfiumX64>
      <_PdfiumX86>$(MSBuildThisFileDirectory)..\Plugin\packages\PdfiumViewer.Native.x86.v8-xfa.2018.4.8.256\Build\x86\pdfium.dll</_PdfiumX86>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)x64" Condition="Exists('$(_PdfiumX64)')" />
    <MakeDir Directories="$(OutputPath)x86" Condition="Exists('$(_PdfiumX86)')" />
    <Copy SourceFiles="$(_PdfiumX64)" DestinationFolder="$(OutputPath)x64" SkipUnchangedFiles="true" Condition="Exists('$(_PdfiumX64)')" />
    <Copy SourceFiles="$(_PdfiumX86)" DestinationFolder="$(OutputPath)x86" SkipUnchangedFiles="true" Condition="Exists('$(_PdfiumX86)')" />
    <Warning Text="未找到 x64\pdfium.dll（$(_PdfiumX64)）。请还原 Plugin 的 PdfiumViewer.Native 包。" Condition="!Exists('$(_PdfiumX64)')" />
  </Target>

  <Target Name="CopyBrowserBridge" AfterTargets="Build">
    <PropertyGroup>
      <_BridgeOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\BrowserBridge\bin\$(Configuration)\net472\YiWriteBrowserBridge.exe'))</_BridgeOut>
    </PropertyGroup>
    <Copy
      SourceFiles="$(_BridgeOut)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Retries="0"
      ContinueOnError="true"
      Condition="Exists('$(_BridgeOut)')" />
    <Warning Text="YiWriteBrowserBridge.exe 未找到（$(_BridgeOut)）。请先编译 BrowserBridge。" Condition="!Exists('$(_BridgeOut)')" />
  </Target>
</Project>
