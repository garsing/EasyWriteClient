<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>WordAddIn1</RootNamespace>
    <AssemblyName>EasyWriteClient.Shared</AssemblyName>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup>
    <OfficePiaDir>C:\Program Files (x86)\Microsoft Visual Studio\Shared\Visual Studio Tools for Office\PIA\Office15</OfficePiaDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="McpTools\backup\**" />
    <EmbeddedResource Remove="McpTools\backup\**" />
    <None Remove="McpTools\backup\**" />
    <!-- 与 Plugin 工程中已注释下线的工具保持一致 -->
    <Compile Remove="McpTools\F_SelectAndAnalyzeDocumentContentTool.cs" />
    <Compile Remove="McpTools\F_SplitDocumentByParagraphsTool.cs" />
    <Compile Remove="McpTools\F_ProcessParagraphActionsTool.cs" />
    <Compile Remove="McpTools\Functions\DocumentProcessor.cs" Condition="Exists('McpTools\Functions\DocumentProcessor.cs')" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 Plugin 相同：Office15 PIA + EmbedInteropTypes -->
    <Reference Include="Office">
      <HintPath>$(OfficePiaDir)\Office.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>$(OfficePiaDir)\Microsoft.Office.Interop.Word.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.Excel">
      <HintPath>$(OfficePiaDir)\Microsoft.Office.Interop.Excel.dll</HintPath>
      <Private>False</Private>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
