{
  "Api": {
    "BaseUrl": "http://localhost:18028",
    // "BaseUrl": "https://addin-api.yi-write.com",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "Endpoints": {
      "Login": "/auth/login",
      "LoginSms": "/auth/login/sms",
      "Register": "/auth/register",
      "SmsSend": "/auth/sms/send",
      "Refresh": "/auth/refresh",
      "Health": "/health"
    }
  },
  "LLMApi": {
    "BaseUrl": "http://localhost:18028",
    // "BaseUrl": "https://addin-api.yi-write.com",
    "TimeoutSeconds": 30,
    "Endpoints": {
      "ChatCompletions": "/llm/chat/completions"
    }
  },
  "App": {
    "Name": "WordAddIn1",
    "Version": "1.0.3",
    "DebugCategories": ["timing"],
    "PreferPdfActivePrinterOnStartup": true,
    "BackendProcessTextLengthThreshold": 60000
  },
  "UI": {
    "Theme": "Black",
    "Language": "zh-CN"
  },
  "DocumentColors": {
    "StrikethroughBackground": "wdColorGray05",
    "InsertBackground": "0xC0FFFF",
    "AcceptButtonBackground": "wdColorLightGreen",
    "RejectButtonBackground": "0xFF99FF"
  },
  "DocumentNavigate": {
    "AutoNavigateAfterModify": true,
    "NavigateAnchor": "first_new_sentence"
  },
  "DocumentActionsAmbiguity": {
    "ContextLeftSentences": 2,
    "ContextRightSentences": 2
  },
  "Workspace": {
    "Mode": "sessions"
  },
  "OpenFiles": {
    "Apps": [
      {
        "Type": "word",
        "DisplayName": "Word",
        "ProcessNames": ["WINWORD"],
        "Extensions": [".doc", ".docx", ".docm", ".dotx", ".dotm"]
      },
      {
        "Type": "wps",
        "DisplayName": "WPS文字",
        "ProcessNames": ["wps"],
        "Extensions": [".doc", ".docx", ".wps", ".wpt"]
      },
      {
        "Type": "excel",
        "DisplayName": "Excel",
        "ProcessNames": ["EXCEL"],
        "Extensions": [".xls", ".xlsx", ".xlsm"]
      },
      {
        "Type": "et",
        "DisplayName": "WPS表格",
        "ProcessNames": ["et"],
        "Extensions": [".xls", ".xlsx", ".xlsm", ".et"]
      },
      {
        "Type": "ppt",
        "DisplayName": "PowerPoint",
        "ProcessNames": ["POWERPNT"],
        "Extensions": [".ppt", ".pptx", ".pptm"]
      },
      {
        "Type": "wpp",
        "DisplayName": "WPS演示",
        "ProcessNames": ["wpp"],
        "Extensions": [".ppt", ".pptx", ".pptm"]
      }
    ]
  },
  "Browser": {
    "ClickMode": "pointer",
    "AttachPointer": "synthetic",
    "YiWrite": {
      "ClickMode": "pointer"
    },
    "Chrome": {
      "ClickMode": "legacy",
      "AttachPointer": "cdp"
    },
    "Edge": {
      "ClickMode": "legacy",
      "AttachPointer": "cdp"
    }
  },
  "ToolStopRisk": {
    "High": [
      "F_process_document_actions",
      "F_insert_document_from_file",
      "F_replace_document_from_file",
      "F_apply_document_format",
      "F_apply_paragraph_format",
      "F_apply_source_format",
      "F_apply_source_paragraph_format",
      "F_apply_source_table_format",
      "F_format_transfer",
      "F_apply_page_setup",
      "F_create_table_from_xml",
      "F_apply_table_format_from_xml",
      "F_apply_table_data_from_xml",
      "F_optimize_table_display",
      "F_delete_table",
      "F_create_chart_from_xml",
      "F_apply_chart_from_xml",
      "F_delete_chart",
      "F_insert_svg_image",
      "F_insert_image",
      "F_delete_image",
      "F_insert_blank_page",
      "F_insert_page_break",
      "F_apply_data_provenance",
      "F_clear_data_provenance",
      "F_apply_ppt_html",
      "F_manage_ppt_shape",
      "F_manage_ppt_slide",
      "F_manage_ppt_lib",
      "F_ppt_transition",
      "F_ppt_animation",
      "F_apply_excel_format",
      "F_apply_excel_conditional_format",
      "F_apply_excel_structure",
      "F_excel_pivot",
      "F_excel_chart",
      "F_manage_excel_sheet",
      "F_write_excel_range",
      "F_restore_document_checkpoint",
      "F_set_track_revisions"
    ],
    "Low": [
      "F_write_file",
      "F_copy_workspace_file",
      "F_write_format_file",
      "F_modify_yaml_file",
      "B_write_python",
      "F_capture_document_page_image",
      "F_capture_ppt_shape",
      "B_capture_kb_document_page_image",
      "B_analyze_kb_document_page_image",
      "F_open_document",
      "F_open_word_document",
      "F_close_document"
    ]
  }
}
